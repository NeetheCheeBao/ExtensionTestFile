#define IDI_APP_ICON 101

IDI_APP_ICON ICON "icon.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     2,0,0,0
 PRODUCTVERSION  2,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ExtensionTestFile"
            VALUE "FileDescription",  "Creates empty files to verify media file type associations"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "CreateExtensionTestFile"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "CreateExtensionTestFile.exe"
            VALUE "ProductName",      "ExtensionTestFile"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
